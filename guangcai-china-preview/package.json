{
  "name": "guangcai-china-v4",
  "version": "7.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "textures": "tsx tools/surface-metrics.ts && node tools/derive-pbr.mjs",
    "test": "tsx --test tools/geometry.test.ts tools/float-normal.test.ts tools/fixed-atlas.test.ts tools/city-selection.test.ts tools/xy-controls.test.ts tools/haptics.test.ts tools/v6-selection.test.ts tools/loop-selector.test.ts tools/glass-compat.test.ts",
    "qa": "node tools/china-qa.mjs",
    "textures:variants": "tsx tools/surface-metrics.ts && node tools/derive-pbr.mjs peony-magnolia && node tools/derive-pbr.mjs lotus-butterfly && node tools/texture-density.mjs && node tools/texture-standards.mjs",
    "qa:textures": "node tools/texture-qa.mjs",
    "evidence": "tsx tools/china-calibration.ts && node tools/china-evidence.mjs",
    "textures:fixed": "node tools/restored-assets.mjs",
    "textures:fixed:legacy": "node tools/original-assets.mjs",
    "textures:china": "python3 tools/china-assets.py",
    "textures:web": "node tools/web-textures.mjs",
    "evidence:v3": "node tools/v3-evidence.mjs",
    "qa:background": "node tools/background-qa-v3.mjs",
    "textures:v4": "python3 tools/compile-city-v4.py && python3 tools/compile-beijing.py && node tools/city-manifest.mjs",
    "qa:v4": "node tools/v4-qa.mjs",
    "textures:beijing": "python3 tools/compile-beijing.py && node tools/city-manifest.mjs",
    "qa:beijing": "node tools/beijing-qa.mjs",
    "qa:v5": "node tools/v5-qa.mjs",
    "textures:v5": "python3 tools/compile-city-v5.py",
    "pipeline:v5": "node tools/v5-pipeline.mjs",
    "deploy:v5": "node tools/deploy-v5.mjs",
    "textures:v6": "python3 tools/compile-city-v6.py && python3 tools/compile-slogan-frame.py && node tools/compile-slogans-v6.mjs",
    "qa:v6": "node tools/v6-qa.mjs",
    "pipeline:v6": "node tools/v6-pipeline.mjs",
    "deploy:v6": "node tools/deploy-v6.mjs",
    "qa:webkit": "node tools/v6-webkit-qa.mjs",
    "textures:v7": "node tools/v7/compile-resources.mjs",
    "build:audit": "tsc --noEmit && vite build --mode audit",
    "build:integration": "tsc --noEmit && vite build --mode integration",
    "mock:v7": "tsx tools/v7/mock-server.ts",
    "qa:v7": "node tools/v7/browser-qa.mjs",
    "test:v7": "tsx --test tools/v7/*.test.ts",
    "check:v7-assets": "node tools/v7/validate-resources.mjs",
    "qa:v7-startup": "node tools/v7/startup-qa.mjs",
    "deploy:v7": "node tools/v7/deploy-preview.mjs"
  },
  "dependencies": {
    "@lisse/core": "0.7.2",
    "three": "0.186.1",
    "vgpu": "0.5.0"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "@vgpu/wgsl": "0.5.0",
    "@webgpu/types": "0.1.74",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  }
}
