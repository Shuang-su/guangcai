{
  "name": "guangcai-ceramic-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "assets": "node tools/bake-artwork.mjs && tsx tools/generate-uv.ts",
    "compress": "node tools/compress-artwork.mjs",
    "check:assets": "node tools/validate-assets.mjs",
    "serve": "node tools/serve-dist.mjs",
    "test:browser": "node tools/qa/browser.mjs",
    "test:touch": "node tools/qa/touch-and-fallback.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/three": "^0.180.0",
    "sharp": "0.35.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
